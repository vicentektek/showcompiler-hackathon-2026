{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RunQ: Syntax checks",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "check:syntax"
      ],
      "problemMatcher": []
    },
    {
      "label": "RunQ: Unit and regression tests",
      "type": "shell",
      "command": "npm",
      "args": [
        "test"
      ],
      "problemMatcher": []
    },
    {
      "label": "RunQ: Cue QA report (offline)",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "qa:cues"
      ],
      "problemMatcher": []
    },
    {
      "label": "RunQ: Full offline QA",
      "dependsOn": [
        "RunQ: Codex QA summary (offline)"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "RunQ: Codex QA summary (offline)",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "qa:codex"
      ],
      "problemMatcher": []
    },
    {
      "label": "RunQ: Seminar benchmark (offline)",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "qa:seminar"
      ],
      "problemMatcher": []
    },
    {
      "label": "RunQ: Meta seminar plan (NO API)",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "qa:meta:plan"
      ],
      "problemMatcher": []
    },
    {
      "label": "RunQ: Systematic Meta test plan (FREE)",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "qa:systematic"
      ],
      "problemMatcher": []
    },
    {
      "label": "RUNQ VIDEO · Prepare English show",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/video/build-the-last-go.mjs"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "RUNQ VIDEO · Check environment",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/video/run-demo-director.mjs",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "RUNQ VIDEO · Show storyboard",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/video/run-demo-director.mjs",
        "--plan"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "RUNQ VIDEO · Script import",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/video/run-demo-director.mjs",
        "--scene",
        "S04",
        "--capture"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "RUNQ VIDEO · Conversational cue editor",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/video/run-demo-director.mjs",
        "--scene",
        "S05",
        "--capture"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "RUNQ VIDEO · Waveform and audio",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/video/run-demo-director.mjs",
        "--scene",
        "S06",
        "--capture"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "RUNQ VIDEO · Rehearsal disarmed",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/video/run-demo-director.mjs",
        "--scene",
        "S07",
        "--capture"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "RUNQ VIDEO · Real voice rehearsal (consent required)",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/video/run-demo-director.mjs",
        "--scene",
        "S08",
        "--mic-wav",
        "production/runq-video-kit/natural-voices/mic-ready/01_linear_en_mic.wav",
        "--voice-opt-in",
        "--capture"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "RUNQ VIDEO · Manual operation",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/video/run-demo-director.mjs",
        "--scene",
        "S09",
        "--capture"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "RUNQ VIDEO · Offline preparation",
      "dependsOn": [
        "RUNQ VIDEO · Prepare English show",
        "RUNQ VIDEO · Check environment"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "RUNQ VIDEO · Operator voice capture with OBS",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/video/run-demo-director.mjs",
        "--scene",
        "S05",
        "--obs",
        "--capture"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "RUNQ_OBS_PASSWORD": "${input:runqObsPassword}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "RUNQ VIDEO · Actor recognition with OBS",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/video/run-demo-director.mjs",
        "--scene",
        "S08",
        "--mic-wav",
        "production/runq-video-kit/natural-voices/mic-ready/02_jump_en_mic.wav",
        "--voice-opt-in",
        "--obs",
        "--capture"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "RUNQ_OBS_PASSWORD": "${input:runqObsPassword}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "RUNQ VIDEO · Manual GO with OBS",
      "type": "shell",
      "command": "node",
      "args": [
        "tools/video/run-demo-director.mjs",
        "--scene",
        "S09",
        "--obs",
        "--capture"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "RUNQ_OBS_PASSWORD": "${input:runqObsPassword}"
        }
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "runqObsPassword",
      "type": "promptString",
      "description": "OBS WebSocket password (local 127.0.0.1:4455; not stored in repository)",
      "password": true
    }
  ]
}
