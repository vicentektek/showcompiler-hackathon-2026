{
  "name": "showcompiler-hackathon-2026",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Hackathon local SHOWCOMPILER demo with human-reviewed AI cues, real browser playback and self-contained audio-inclusive show ZIP",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo:core": "node tools/review-demo.mjs",
    "smoke:meta": "node tools/meta-smoke.mjs",
    "dev": "node tools/dev-server.mjs",
    "check:syntax": "node tools/check-syntax.mjs",
    "demo:package": "node tools/build-demo-package.mjs",
    "demo:rehearsal": "node tools/build-rehearsal-demo.mjs",
    "sfx:doctor": "node tools/runq-sfx-doctor.mjs",
    "qa:cues": "node tools/cue-qa-report.mjs",
    "qa:codex": "npm run check:syntax && npm test && npm run qa:cues && npm run qa:seminar && node tools/codex-qa-summary.mjs",
    "qa:seminar": "node tools/seminar-offline-eval.mjs",
    "qa:meta:plan": "node tools/run-meta-seminar-eval.mjs",
    "qa:meta:live": "node tools/run-meta-seminar-eval.mjs --live --ack-paid --budget-usd 2 --max-requests 13 --mode literal",
    "qa:systematic": "node tools/runq-systematic-lab.mjs",
    "qa:baseten:plan": "node tools/run-baseten-seminar-eval.mjs",
    "qa:compare-providers": "node tools/compare-provider-seminar.mjs",
    "qa:ai:preflight": "node tools/runq-ai-preflight.mjs",
    "qa:ai:campaign": "node tools/runq-ai-campaign.mjs",
    "qa:voice:campaign": "node tools/runq-voice-edit-campaign.mjs",
    "qa:agent:mass": "node tools/runq-agent-mass-eval.mjs --cases 600 --seed 20261029",
    "qa:agent:live:plan": "node tools/runq-agent-live-eval.mjs --cases 200 --providers meta,baseten --budget-usd 30 --reserve-usd 0.15",
    "qa:agent:live": "node tools/runq-agent-live-eval.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "libarchive.js": "2.0.2"
  }
}
