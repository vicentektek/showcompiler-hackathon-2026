# Server-side provider variables only. Leave values empty in version control.
MODEL_API_KEY=
BASETEN_API_KEY=

# Modal authentication is managed by `modal profile`; never store Modal tokens here.

# Modal SFX pilot (server side only). Enable only after `modal deploy`, a
# dedicated proxy token pair and a confirmed spend decision. Values are set in
# a local `.env`, never committed. HF_TOKEN is delivered exclusively through
# Modal key-vault injection (see modal/runq_sfx_pilot.py) and must never be
# pasted here.
RUNQ_SFX_PILOT_ENABLED=
MODAL_SFX_ENDPOINT=
# Proxy credentials: the two client authentication variable names (identifier
# plus paired confidential value) are documented verbatim in
# docs/SFX_GENERATION_PILOT_2026-10-28.md "Contrato HTTP interno / Cliente Node".
MODAL_PROXY_TOKEN_ID=
RUNQ_SFX_ESTIMATED_MAX_COST_USD=
RUNQ_SFX_DAILY_BUDGET_USD=
# Journal-visible weights revision (Hugging Face commit of the gated repo):
# stabilityai/stable-audio-3-small-sfx @ 2026-10-06 = 05ca3857881c94a2b84026b1111c537d78f5f9f0
RUNQ_SFX_MODEL_REVISION=
